<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <Button
        android:id="@+id/btnCuentas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Módulo 1: Cuentas y Movimientos" />

    <Button
        android:id="@+id/btnMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Ver Mapa Offline" />

    <Button
        android:id="@+id/btnCompras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Módulo 2: Compras" />

    <Button
        android:id="@+id/btnDeudas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Módulo 3: Deudas y Contactos" />
</LinearLayout>